---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Sidebar from "@/components/Sidebar.astro";
import MobileNav from "@/components/MobileNav.astro";
import SocialLinkCard, { type SocialLinkData } from "@/components/SocialLinkCard.astro";
import SocialLinkChip, { type SocialLinkChipData } from "@/components/SocialLinkChip.astro";
import ProfileItem from "@/components/ProfileItem.astro";
import FriendCodeItem from "@/components/FriendCodeItem.astro";
import TimelineEntry, { type TimelineEntryData } from "@/components/TimelineEntry.astro";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { siteConfig } from "@/lib/seo";

/** Primary channels: shown as full detail cards */
const primarySocialLinks: SocialLinkData[] = [
  {
    name: "YouTube",
    username: "@ngtkana",
    url: "https://www.youtube.com/@ngtkana",
    iconName: "youtube",
    accentColor: "var(--social-youtube)",
    description: "ボカロ曲を中心に、歌ってみた動画を投稿しております。まずは聴いていきましょう！",
    ariaLabel: "YouTube チャンネル @ngtkana",
  },
  {
    name: "X (Twitter)",
    username: "@ngtkana",
    url: "https://x.com/ngtkana",
    iconName: "twitter",
    accentColor: "var(--social-twitter)",
    description: "新作のダジャレを投稿しております。",
    ariaLabel: "X (Twitter) アカウント @ngtkana",
  },
];

/** Community channels: shown as a compact chip row */
const communitySocialLinks: SocialLinkChipData[] = [
  {
    name: "ながたかなのお部屋",
    username: "Discord",
    url: "https://discord.gg/wsMFhNCVEr",
    iconName: "discord",
    accentColor: "var(--social-discord)",
    ariaLabel: "ながたかな ファンコミュニティ Discord サーバー",
  },
  {
    name: "Twitch",
    username: "ngtkana",
    url: "https://www.twitch.tv/ngtkana",
    iconName: "twitch",
    accentColor: "var(--social-twitch)",
    ariaLabel: "Twitch チャンネル ngtkana",
  },
  {
    name: "ニコニコ動画",
    username: "user/97990641",
    url: "https://www.nicovideo.jp/user/97990641",
    iconName: "niconico",
    accentColor: "var(--social-niconico)",
    ariaLabel: "ニコニコ動画 ユーザー",
  },
  {
    name: "はてなブログ",
    username: "ngtkana",
    url: "https://ngtkana.hatenablog.com/",
    iconName: "blog",
    accentColor: "var(--social-hatena)",
    ariaLabel: "はてなブログ",
  },
];

/** Competitive-programming-adjacent links: a tangential interest, kept small and separate */
const competitiveSocialLinks: SocialLinkChipData[] = [
  {
    name: "AtCoder",
    username: "ngtkana",
    url: "https://atcoder.jp/users/ngtkana",
    iconName: "atcoder",
    accentColor: "var(--social-atcoder)",
    ariaLabel: "AtCoder プロフィール",
  },
  {
    name: "GitHub",
    username: "ngtkana",
    url: "https://github.com/ngtkana",
    iconName: "github",
    accentColor: "var(--color-text-secondary)",
    ariaLabel: "GitHub プロフィール",
  },
  {
    name: "kyoprusteseans",
    username: "Discord",
    url: "https://discord.com/invite/RmRCzPnFPc",
    iconName: "discord",
    accentColor: "var(--social-discord)",
    ariaLabel: "競技プログラミング Rust Discord サーバー",
  },
];

const timelineEntries: TimelineEntryData[] = [
  {
    date: "2024年8月1日",
    title: "カービィ使いになりました",
    description: "スマブラSPはこの子と一緒に戦っていきます。",
  },
  {
    date: "2023年9月28日",
    title: "3Dデビューしました",
    description: "実は初配信はツイキャス。",
  },
  {
    date: "2023年7月27日",
    title: "Twitch でゲーム配信を初めました",
    description: "当初は様々なゲームをしておりました。",
  },
  {
    date: "2021年12月4日",
    title: "YouTubeチャンネル開設",
    description: "ボカロ曲を中心に、歌ってみた動画の投稿を開始しました。",
  },
];
---

<Layout description="ながたかなの公式ウェブサイトへようこそ。歌い手として活動しています。">
  <div id="mobile-nav-wrapper" class="mobile-nav-wrapper">
    <MobileNav />
  </div>

  <div class="page-shell">
    <Sidebar
      title={siteConfig.name}
      subtitle="歌い手 | Vocalist"
      description={siteConfig.description}
      primaryLinks={primarySocialLinks}
    />

    <main class="main-column">
    <Hero />

    <Section id="about" title="About">
      <div class="prose-block">
        <p>
          2021 年 12 月 YouTube にて活動を開始。 ボカロ曲を中心に歌ってみた動画の投稿を続けております。
          みなさまの心に届くような歌声を目指して、これからも活動を続けていきたいです。
          よかったら遊びにきてくださいね！
        </p>
      </div>
    </Section>

    <Section id="connect" title="Social Links" animationDelay="animate-delay-50">
      <div class="social-primary-grid">
        {
          primarySocialLinks.map((link, index) => (
            <SocialLinkCard
              link={link}
              class={`opacity-0 animate-fade-in animate-delay-${String((index + 1) * 100)}`}
            />
          ))
        }
      </div>

      <div class="social-chip-row">
        {communitySocialLinks.map((link) => <SocialLinkChip link={link} />)}
      </div>

      <div class="social-competitive">
        <p class="social-competitive-label">競技プログラミングがお好きな方へ</p>
        <div class="social-chip-row">
          {competitiveSocialLinks.map((link) => <SocialLinkChip link={link} />)}
        </div>
      </div>
    </Section>

    <Section id="videos" title="Latest Videos" animationDelay="animate-delay-100">
      <div class="video-frame">
        <YouTubeEmbed
          class="video-iframe"
          src="https://www.youtube.com/embed/videoseries?si=7C_sU_ZCgZmRAY8p&list=PLthQZA1nE6DLzxQZfPr4LHaUFHOe3zt71"
          title="YouTube プレイリスト"
        />
      </div>
    </Section>

    <Section id="profile" title="Profile" animationDelay="animate-delay-150">
      <div class="prose-block">
        <dl class="profile-list">
          <ProfileItem label="身長">ながいです。</ProfileItem>
          <ProfileItem label="体重">浮力に負けます。</ProfileItem>
          <ProfileItem label="年齢"
            >私のいない宇宙って、それ存在しないも同然なのですよね。従って、おそらく 150
            億年以上です。</ProfileItem
          >
          <ProfileItem label="お誕生日">4/11 です。プレゼントお待ちしております。</ProfileItem>
          <ProfileItem label="得意なこと">お歌と数学です。</ProfileItem>
          <ProfileItem label="星座">ピザ</ProfileItem>
        </dl>
      </div>
    </Section>

    <Section id="friend-codes" title="Friend Codes" animationDelay="animate-delay-200">
      <div class="prose-block">
        <dl class="profile-list">
          <FriendCodeItem label="Nintendo Switch">SW-7763-1448-3304</FriendCodeItem>
          <FriendCodeItem label="Steam">1176233303</FriendCodeItem>
          <FriendCodeItem label="Discord">536811801569132544</FriendCodeItem>
        </dl>
      </div>
    </Section>

    <Section id="history" title="History" animationDelay="animate-delay-300">
      <div class="timeline-block">
        <TimelineEntry
          title="今日"
          description="みなさまが私と出会えた記念すべき日である可能性が高いわけですね。"
          useDynamicDate
          class="opacity-0 animate-slide-in animate-delay-100"
        />
        {
          timelineEntries.map((entry, index) => (
            <TimelineEntry
              entry={entry}
              isLast={index === timelineEntries.length - 1}
              class={`opacity-0 animate-slide-in animate-delay-${String((index % 5) + 1)}00`}
            />
          ))
        }
      </div>
    </Section>

    <Section id="contact" title="Contact" animationDelay="animate-delay-400">
      <div class="prose-block">
        <p>お誘いは、X の DM までぜひです。</p>
        <p>私がフォローしていない方からの DM、気づきづらくて申し訳ないです。</p>
        <p>歌い手さんへ。コラボしましょう！ 作曲者さんへ。私の声いりませんか？</p>
      </div>
    </Section>
    </main>
  </div>
</Layout>

<style>
  /* Mobile/tablet quick-jump nav. The desktop sidebar has its own nav list
     instead, so this is hidden at that breakpoint entirely. */
  .mobile-nav-wrapper {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 50;
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  /* Reveal only once scrolled past the identity panel, since it sits at
     the very top of the page and a fixed button there would otherwise
     overlap its heading text. */
  .mobile-nav-wrapper.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-wrapper {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .mobile-nav-wrapper {
      display: none;
    }
  }

  .page-shell {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 1024px) {
    .page-shell {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 3rem;
      padding-inline: 2rem;
      align-items: start;
    }
  }

  .main-column {
    display: block;
    padding-block: 1.5rem 3rem;
  }

  @media (min-width: 1024px) {
    .main-column {
      padding-block: 2rem 4rem;
    }
  }

  .prose-block {
    max-width: 48rem;
    margin-inline: auto;
  }

  .prose-block p {
    margin: 0 0 1rem;
  }

  .profile-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-primary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .social-primary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .social-chip-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-competitive {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .social-competitive-label {
    margin: 0 0 0.75rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .video-frame :global(.video-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .timeline-block {
    max-width: 42rem;
    margin-inline: auto;
  }
</style>

<script>
  // The identity panel (name/tagline/description) sits at the very top of
  // the page on mobile/tablet, so a fixed nav button there would overlap
  // its heading text. Reveal the button only once scrolled past it.
  const navWrapper = document.getElementById("mobile-nav-wrapper");
  const identityPanel = document.getElementById("identity-panel");

  if (navWrapper && identityPanel) {
    const setVisible = (visible: boolean) => {
      navWrapper.classList.toggle("is-visible", visible);
      navWrapper.inert = !visible;
    };

    const observer = new IntersectionObserver(([entry]) => {
      setVisible(!entry.isIntersecting);
    });
    observer.observe(identityPanel);
  }
</script>

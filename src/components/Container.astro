---
export type ContainerSize = "sm" | "md" | "lg" | "xl" | "full";
export type ContainerPadding = "none" | "sm" | "md" | "lg";

interface Props {
  size?: ContainerSize;
  padding?: ContainerPadding;
  class?: string;
  id?: string;
  tag?: "div" | "section" | "footer" | "header";
}

const { size = "xl", padding = "md", class: className = "", id, tag: Tag = "div" } = Astro.props;
---

<Tag class:list={["container-block", className]} data-size={size} data-padding={padding} id={id}>
  <slot />
</Tag>

<style>
  .container-block {
    width: 100%;
    margin-inline: auto;
  }

  .container-block[data-size="sm"] {
    max-width: 640px;
  }
  .container-block[data-size="md"] {
    max-width: 768px;
  }
  .container-block[data-size="lg"] {
    max-width: 1024px;
  }
  .container-block[data-size="xl"] {
    max-width: 1280px;
  }
  .container-block[data-size="full"] {
    max-width: 100%;
  }

  .container-block[data-padding="none"] {
    padding-inline: 0;
  }
  .container-block[data-padding="sm"] {
    padding-inline: 1rem;
  }
  .container-block[data-padding="md"] {
    padding-inline: 1.5rem;
  }
  .container-block[data-padding="lg"] {
    padding-inline: 1.5rem;
  }

  @media (min-width: 768px) {
    .container-block[data-padding="md"] {
      padding-inline: 2rem;
    }
    .container-block[data-padding="lg"] {
      padding-inline: 3rem;
    }
  }
</style>

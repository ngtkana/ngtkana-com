---
import Icon, { type IconName } from "@/components/Icon.astro";
import { sanitizeUrl } from "@/lib/urlUtils";

export interface SocialLinkChipData {
  name: string;
  username: string;
  url: string;
  iconName: IconName;
  accentColor: string;
  ariaLabel: string;
}

interface Props {
  link: SocialLinkChipData;
  class?: string;
}

const { link, class: className = "" } = Astro.props;
const safeUrl = sanitizeUrl(link.url);

if (!safeUrl) {
  console.warn(`Invalid URL detected for ${link.name}: ${link.url}`);
}
---

{
  safeUrl && (
    <a
      href={safeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["social-link-chip", className]}
      aria-label={link.ariaLabel}
      data-social-link
      data-name={link.name}
      data-username={link.username}
      data-url={safeUrl}
      style={`--accent-color:${link.accentColor}`}
    >
      <span class="social-link-chip-icon">
        <Icon name={link.iconName} size="sm" />
      </span>
      <span class="social-link-chip-name">{link.name}</span>
    </a>
  )
}

<style>
  .social-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-bg-primary);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .social-link-chip:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .social-link-chip-icon {
    display: flex;
    color: var(--accent-color);
  }
</style>

<script>
  import { trackLinkClick, trackLinkIfVideo } from "@/lib/analytics";

  document
    .querySelectorAll<HTMLAnchorElement>("a.social-link-chip[data-social-link]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        const name = link.dataset.name ?? "";
        const username = link.dataset.username ?? "";
        const url = link.dataset.url ?? "";

        trackLinkClick("social", name, url);
        trackLinkIfVideo(name, username, url);
      });
    });
</script>

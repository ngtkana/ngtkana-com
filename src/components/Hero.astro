---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.jpg";

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---

<div class="hero" role="banner" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{title}</h1>
  {subtitle && <p class="sr-only">{subtitle}</p>}
  {description && <p class="sr-only">{description}</p>}

  <Image
    class="hero-image"
    src={heroImage}
    alt="インターネットお歌歌い手ながたかなのバナーイラスト「ゆっくりしていってね」"
    widths={[480, 750, 1500]}
    sizes="100vw"
    format="webp"
    priority
  />

  <div class="hero-scroll-indicator" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</div>

<style>
  .hero {
    width: 100%;
    aspect-ratio: 1.7 / 1;
    position: relative;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  @media (min-width: 640px) {
    .hero {
      aspect-ratio: 3 / 1;
      max-height: 40rem;
    }
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* On the narrow 1.7:1 mobile crop, favor the character + name over the
       left-side greeting text so the readable focal point stays in frame. */
    object-position: 85% center;
  }

  @media (min-width: 640px) {
    .hero-image {
      object-position: center;
    }
  }

  .hero-scroll-indicator {
    display: none;
  }

  @media (min-width: 640px) {
    .hero-scroll-indicator {
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.35);
      backdrop-filter: blur(4px);
      color: white;
      animation: bounce 1.4s infinite;
    }
  }

  .hero-scroll-indicator svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-25%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-indicator {
      animation: none;
    }
  }
</style>

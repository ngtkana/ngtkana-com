---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.jpg";

// The `sizes` value below re-states the `.page-shell` grid in src/pages/index.astro
// (max-width 1280px, padding-inline 2rem, 260px sidebar, 3rem gap) — that file is the
// source of truth. Nothing links the two, so changing the grid there without changing
// this makes the browser pick a wrong-sized candidate for the LCP image, silently.
---

<Image
  class="hero"
  src={heroImage}
  alt="両手でハートマークを作ってほほえむ、ながたかなのイラスト"
  widths={[480, 768, 1080, 1600, 1920]}
  sizes="(min-width: 1024px) calc(min(100vw, 1280px) - 4rem - 260px - 3rem), calc(100vw - 3rem)"
  format="webp"
  priority
/>

<style>
  /* The illustration is the whole point of the hero, so it's shown uncropped at its
     native aspect ratio rather than cropped into a fixed-height band. The rounded
     corners and shadow match the video frame further down the page; the bottom margin
     keeps the shadow from spilling onto the "About" heading, which would otherwise
     start at the image's exact bottom edge. */
  .hero {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }
</style>

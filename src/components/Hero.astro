---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.jpg";
---

<div class="hero">
  <Image
    class="hero-image"
    src={heroImage}
    alt="インターネットお歌歌い手ながたかなのバナーイラスト「ゆっくりしていってね」"
    widths={[480, 750, 1500]}
    sizes="(min-width: 1024px) 900px, 100vw"
    format="webp"
    priority
  />
</div>

<style>
  .hero {
    width: 100%;
    height: 11rem;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .hero {
      height: 13.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: 16rem;
    }
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Favor the character + name on the narrower crops; there's enough
       height at wider crops that centering keeps everything in frame. */
    object-position: 80% center;
  }

  @media (min-width: 1024px) {
    .hero-image {
      object-position: center;
    }
  }
</style>
